                      "nfc": false,
                      "address": "Av. Siempre Viva 123",
                      "front": "<base64>",
                      "back": "<base64>",
                      "photo": "<base64>"
                    },
                    "sessionId": "2ce323e2-c606-44fb-b092-d94cedb2b30d",
                    "idDevice": "dLSc78vZAUHUiT52B4KnWb:APA91b...<fcm-token>",
