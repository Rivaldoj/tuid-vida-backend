                      "telefonoVrf": false,
                      "emailVrf": false,
                      "addressVrf": false,
                      "attestVrf": false
                    }
                  },
                  "revancha": {
                    "summary": "Revancha (similitud intermedia, requiere pregunta)",
                    "value": {
                      "res": "ok",
                      "status": 200,
                      "message": "chance",
