{
  "openapi": "3.0.0",
  "info": {
    "title": "TuID Authenticator API v2",
    "version": "2.0.0",
    "description": "API v2 de TuID Authenticator"
  },
  "servers": [
    {
      "url": "/authenticator/v2",
      "description": "Authenticator v2"
    }
  ],
  "tags": [
    {
      "name": "Register",
      "description": "Endpoints de registro y búsqueda de usuarios"
    },
    {
      "name": "Testing",
      "description": "Endpoints auxiliares para pruebas internas"
    },
    {
      "name": "Legal",
      "description": "Términos y condiciones y política de privacidad por marca blanca"
    },
    {
      "name": "Address",
      "description": "Catálogo de localidades y actualización de domicilio del usuario"
    },
    {
      "name": "Attest",
      "description": "Apple App Attest: challenge de enroll (sin liveness) y registro de la key de la instalación iOS"
    }
  ],
  "paths": {
    "/address": {
      "post": {
        "summary": "Actualizar domicilio del usuario",
        "description": "Guarda el domicilio declarado en `usuario_direccion`, marca `addressVrf = 1` y, si todas las validaciones mandatory del whitebrand están cumplidas (`mail` / `phone` / `address`), pasa el usuario a `estado = Ok` y dispara el webhook de alta. Usa el mismo `authToken` que email/teléfono (`body.token`).",
        "tags": ["Address"],
        "operationId": "updateAddress",
        "security": [{ "WhiteBrandAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateAddressRequest" },
              "examples": {
                "ok": {
                  "summary": "Domicilio Argentina",
                  "value": {
                    "token": "<authToken>",
                    "pais": "AR",
                    "provincia": "BUENOS AIRES",
                    "localidad": "25 DE MAYO",
                    "codigoPostal": "6660",
                    "calle": "Av. Siempre Viva",
                    "numero": "123",
                    "piso": "2",
                    "depto": "B",
                    "codigoUta": "068540854100000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la actualización (incluye errores de negocio con status en body)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpdateAddressResponse" },
                "examples": {
                  "okComplete": {
                    "summary": "Dirección guardada y usuario Ok",
                    "value": {
                      "res": "ok",
                      "status": 200,
                      "message": "Ok",
                      "addressVrf": true
                    }
                  },
                  "okPending": {
                    "summary": "Dirección guardada, faltan otras validaciones",
                    "value": {
                      "res": "ok",
                      "status": 200,
                      "message": "Verificar",
                      "addressVrf": true
                    }
                  },
                  "tokenExpired": {
                    "summary": "Token inválido o vencido",
                    "value": {
                      "res": "error",
                      "status": 400,
                      "message": "Token de identificacion de DNI vencido, inicie el proceso nuevamente"
                    }
                  },
                  "missingFields": {
                    "summary": "Campos faltantes",
                    "value": {
                      "res": "error",
                      "status": 400,
                      "message": "Faltan campos de dirección: calle, numero"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" }
              }
            }
          }
        }
      }
    },
    "/localities": {
      "get": {
        "summary": "Obtener localidades de Argentina",
        "description": "Devuelve el catálogo jerárquico de provincias, departamentos, municipios y localidades de Argentina (archivo `resources/AR_min.json`). Cada localidad incluye `name` y `code` (código UTA 2020).",
        "tags": ["Address"],
        "operationId": "getLocalities",
        "security": [{ "WhiteBrandAuth": [] }],
        "responses": {
          "200": {
            "description": "Catálogo de localidades",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LocalitiesResponse" },
                "examples": {
                  "ok": {
                    "summary": "Estructura jerárquica",
                    "value": {
                      "provincias": [
                        {
                          "name": "BUENOS AIRES",
                          "departamentos": [
                            {
                              "name": "25 DE MAYO",
                              "municipios": [
                                {
                                  "name": "25 DE MAYO",
                                  "localidades": [
                                    {
                                      "name": "25 DE MAYO",
                                      "code": "068540854100000"
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "departamentos_selectable": true,
                          "departamento_label": "Partido",
                          "municipios_selectable": true,
                          "municipio_label": "Municipio",
                          "localidad_label": "Localidad"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" }
              }
            }
          }
        }
      }
    },
    "/tyc": {
      "get": {
        "summary": "Obtener Términos y Condiciones",
        "description": "Devuelve el HTML de Términos y Condiciones correspondiente a la marca blanca autenticada (`{brandId}_tyc.html`).",
        "tags": ["Legal"],
        "operationId": "getTyc",
        "security": [{ "WhiteBrandAuth": [] }],
        "responses": {
          "200": {
            "description": "Documento legal",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegalDocumentResponse" },
                "examples": {
                  "ok": {
                    "summary": "Términos y condiciones",
                    "value": {
                      "res": "ok",
                      "status": 200,
                      "brand": "kiwipayauth",
                      "brandName": "Kiwipay Auth",
                      "type": "tyc",
                      "html": "<!DOCTYPE html><html>...</html>"
                    }
                  },
                  "notFound": {
                    "summary": "Documento no encontrado",
                    "value": {
                      "res": "error",
                      "status": 404,
                      "message": "Documento no encontrado para esta marca",
                      "brand": "kiwipayauth",
                      "type": "tyc"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" }
              }
            }
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "summary": "Obtener Política de Privacidad",
        "description": "Devuelve el HTML de Política de Privacidad correspondiente a la marca blanca autenticada (`{brandId}_privacy.html`).",
        "tags": ["Legal"],
        "operationId": "getPrivacy",
        "security": [{ "WhiteBrandAuth": [] }],
        "responses": {
          "200": {
            "description": "Documento legal",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegalDocumentResponse" },
                "examples": {
                  "ok": {
                    "summary": "Política de privacidad",
                    "value": {
                      "res": "ok",
                      "status": 200,
                      "brand": "kiwipayauth",
                      "brandName": "Kiwipay Auth",
                      "type": "privacy",
                      "html": "<!DOCTYPE html><html>...</html>"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" }
              }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Crear sesión de Face Liveness",
        "description": "Crea una sesión de Face Liveness (AWS Rekognition) y persiste el `sessionId` como challenge de assertion de App Attest en el signup (TTL de la marca). No usar este endpoint solo para enrolar: para eso está `GET /attest/challenge`.",
        "tags": ["Register"],
        "operationId": "createLivenessSession",
        "security": [{ "WhiteBrandAuth": [] }],
        "responses": {
          "200": {
            "description": "Sesión de liveness creada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "description": "ID de Face Liveness. En signup es también el challenge de la assertion (`X-App-Attest-Challenge`).",
                      "example": "7792d95f-7f7e-42a8-87b2-b48c7f7d4ac6"
                    }
                  }
                },
                "examples": {
                  "ok": {
                    "summary": "Sesión creada",
                    "value": { "sessionId": "7792d95f-7f7e-42a8-87b2-b48c7f7d4ac6" }
                  },
                  "error": {
                    "summary": "Error al crear la sesión",
                    "value": { "res": "error", "status": 400, "message": "Error creando la sesión de liveness" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/attest/challenge": {
      "get": {
        "summary": "Emitir challenge de App Attest (enroll)",
        "description": "Devuelve un nonce y lo persiste en `app_attest_challenge` (TTL de la marca). No crea sesión de Face Liveness. Usar este `challenge` en `POST /attest/enroll`. El signup sigue usando el `sessionId` de liveness como challenge de assertion.",
        "tags": ["Attest"],
        "operationId": "getAppAttestChallenge",
        "security": [{ "WhiteBrandAuth": [] }],
        "responses": {
          "200": {
            "description": "Challenge emitido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppAttestChallengeResponse" },
                "examples": {
                  "ok": {
                    "summary": "Challenge",
                    "value": { "challenge": "a1b2c3d4-e5f6-7890-abcd-ef1234567890" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" }
              }
            }
          }
        }
      }
    },
    "/attest/enroll": {
      "post": {
        "summary": "Enrolar key de Apple App Attest",
        "description": "Verifica la attestation de Apple (`DCAppAttestService.attestKey`) usando el `challenge` de `GET /attest/challenge` (recomendado) o, si todavía lo usan, un `sessionId` de liveness. Si es válida, guarda la public key de esa instalación. Un enroll inválido no impide el signup (el alta quedará con `attestVrf: false`).",
        "tags": ["Attest"],
        "operationId": "enrollAppAttest",
        "security": [{ "WhiteBrandAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppAttestEnrollRequest" },
              "examples": {
                "ok": {
                  "summary": "Enroll iOS",
                  "value": {
                    "keyId": "<base64 keyId>",
                    "attestation": "<base64 attestation object>",
                    "challenge": "7792d95f-7f7e-42a8-87b2-b48c7f7d4ac6"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del enroll (errores de negocio con status en body)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppAttestEnrollResponse" },
                "examples": {
                  "ok": {
                    "summary": "Key enrolada",
                    "value": { "res": "ok", "status": 200, "message": "Key enrolada", "keyId": "<base64 keyId>" }
                  },
                  "invalid": {
                    "summary": "Attestation inválida",
                    "value": { "res": "error", "status": 400, "message": "Attestation inválida" }
                  },
                  "challenge": {
                    "summary": "Challenge inválido o vencido",
                    "value": { "res": "error", "status": 400, "message": "Challenge inválido o vencido" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" }
              }
            }
          }
        }
      }
    },
    "/test/{idJson}": {
      "get": {
        "summary": "Reprocesar signup desde un body guardado",
        "description": "Endpoint de prueba interno. Carga un body previamente persistido por `/signup` en `logs/signup/{idJson}.json` y vuelve a ejecutar toda la cadena de registro (validación de usuario, datos, subida de imágenes, comparación de rostro/liveness, PEP y alta). Útil para reprocesar o depurar un registro sin tener que reenviar las imágenes desde el cliente.",
        "tags": ["Testing"],
        "operationId": "loadTestBody",
        "security": [{ "WhiteBrandAuth": [] }],
        "parameters": [
          {
            "name": "idJson",
            "in": "path",
            "required": true,
            "description": "Nombre (sin extensión) del archivo guardado en `logs/signup/`. Por ejemplo `1` para `logs/signup/1.json`.",
            "schema": {
              "type": "string",
              "example": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado del reprocesamiento del signup (mismo formato que `/signup`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                },
                "examples": {
                  "notFound": {
                    "summary": "JSON de prueba inexistente",
                    "value": {
                      "res": "error",
                      "status": 200,
                      "message": "No se encontró el JSON de prueba: 1"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/signup": {
      "post": {
        "summary": "Registrar usuario (signup)",
        "description": "Ejecuta el alta del usuario: valida datos contra el master, sube las imagenes del DNI, compara el rostro de la sesion de Face Liveness contra la foto del documento y crea/actualiza el registro. Segun la similitud puede aprobar (`message: Ok`/`Verificar`), pedir una pregunta de conocimiento (`message: chance`, banda intermedia) o rechazar (`res: error`). El `status` del body queda en 200 en todo el flujo de signup. Headers opcionales de App Attest (`X-App-Attest-*`): si la assertion es válida se persiste `attestVrf: true` (también firmado en el `authToken`); si faltan o fallan el alta sigue con `attestVrf: false`.",
        "tags": ["Register"],
        "operationId": "signupUser",
        "security": [{ "WhiteBrandAuth": [] }],
        "parameters": [
          {
            "name": "X-App-Attest-KeyId",
            "in": "header",
            "required": false,
            "description": "keyId de App Attest (base64). Opcional; si falta el alta sigue con attestVrf false.",
            "schema": { "type": "string" }
          },
          {
            "name": "X-App-Attest-Challenge",
            "in": "header",
            "required": false,
            "description": "Debe coincidir con el sessionId de liveness.",
            "schema": { "type": "string" }
          },
          {
            "name": "X-App-Attest-Assertion",
            "in": "header",
            "required": false,
            "description": "Assertion de App Attest en base64. clientDataHash = SHA256(sessionId || SHA256(rawBody)).",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              },
              "examples": {
                "ultimoDni": {
                  "summary": "Ultimo DNI (type L, leido por NFC)",
                  "value": {
                    "idDocument": {
                      "type": "L",
                      "number": "35273106",
                      "gender": "M",
                      "name": "IGNACIO MARTIN",
                      "lastname": "ROSA",
                      "birth": "1990-07-18",
                      "issue": "07/04/2023",
                      "expires": "07/04/2038",
                      "tramit": "00703219306",
                      "nfc": true,
                      "nfcCode": "123456",
                      "example": "C",
                      "address": "Av. Siempre Viva 123",
                      "front": "<base64>",
                      "back": "<base64>",
                      "photo": "<base64>"
                    },
                    "sessionId": "2ce323e2-c606-44fb-b092-d94cedb2b30d",
                    "idDevice": "dLSc78vZAUHUiT52B4KnWb:APA91b...<fcm-token>",
                    "os": "IOS-iPhone15,4",
                    "version": "18.7.8",
                    "esPep": false,
                    "vinculoPep": "",
                    "cargoPep": "",
                    "esSujetoObligado": false,
                    "tipoSujetoObligado": ""
                  }
                },
                "dniAnterior": {
                  "summary": "DNI Anterior (type N, sin NFC)",
                  "value": {
                    "idDocument": {
