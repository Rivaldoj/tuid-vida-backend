                  "livenessFallido": {
                    "summary": "Error: prueba de vida no superada",
                    "value": {
                      "res": "error",
                      "status": 200,
                      "message": "No se pudo confirmar la prueba de vida. Por favor intente nuevamente.",
                      "confidence": 42.1
                    }
                  },
                  "similitudBaja": {
                    "summary": "Error: rostro no coincide (similitud baja)",
                    "value": {
                      "res": "error",
                      "status": 200,
                      "message": "No nos fue posible realizar la Autenticacion. Su informacion personal y los datos biometricos obtenidos no son coincidentes.",
                      "similarity": 31.4
                    }
                  },
                  "datosNoCoinciden": {
                    "summary": "Error: datos del DNI no coinciden con el master",
                    "value": {
                      "res": "error",
                      "status": 200,
                      "message": "Los datos del DNI no coinciden con nuestra base de datos"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "summary": "Buscar usuario",
        "description": "Busca un usuario por documento y género dentro de la aplicación (whitebrand) autenticada. Si el usuario no existe, no finalizó el registro o el whitebrand tiene `alwayRegister`, responde con `res: GoToSignup`, `status: 200`, `liveness: true` y un `sessionId` de Face Liveness (AWS Rekognition). Cuando el usuario existe y está validado (`estado = Ok`), responde con `res: GoToLogin`, `status: 201` y `liveness: false`. Cuando el whitebrand tiene `alwayRegister`, el mensaje es `Registrar siempre`.",
        "tags": ["Register"],
        "operationId": "searchUser",
        "security": [{ "WhiteBrandAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta de búsqueda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "examples": {
                  "notFound": {
                    "summary": "Usuario no encontrado",
                    "value": {
                      "res": "GoToSignup",
                      "status": 200,
                      "message": "Usuario no encontrado - Continuar con el registro",
                      "sessionId": "abc123-session-id",
                      "liveness": true
                    }
                  },
                  "found": {
                    "summary": "Usuario encontrado",
                    "value": {
                      "res": "GoToLogin",
                      "status": 201,
                      "message": "Usuario encontrado",
                      "liveness": false
                    }
                  },
                  "incompleteRegistration": {
                    "summary": "Registro incompleto",
                    "value": {
                      "res": "GoToSignup",
                      "status": 200,
                      "message": "Usuario no finalizo el registro - Continuar con el registro",
                      "sessionId": "abc123-session-id",
                      "liveness": true
                    }
                  },
                  "clientNotFound": {
                    "summary": "Cliente no encontrado",
                    "value": {
                      "res": "error",
                      "status": 400,
                      "message": "Cliente no encontrado"
                    }
                  },
                  "alwaysRegister": {
                    "summary": "Whitebrand con registro forzado",
                    "value": {
                      "res": "GoToSignup",
                      "status": 200,
                      "message": "Registrar siempre",
                      "sessionId": "abc123-session-id",
                      "liveness": true
                    }
                  },
                  "searchError": {
                    "summary": "Error al buscar",
                    "value": {
                      "res": "error",
                      "status": 400,
                      "message": "Error al buscar el usuario",
                      "details": {}
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WhiteBrandAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Token del whitebrand habilitado"
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "required": ["document", "gender"],
        "properties": {
          "document": {
            "type": "string",
            "description": "Número de documento (DNI)",
            "example": "12345678"
          },
          "gender": {
            "type": "string",
            "description": "Sexo del titular del documento",
            "example": "M"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "res": {
            "type": "string",
            "description": "Acción a tomar en el cliente: `GoToSignup` (continuar registro), `GoToLogin` (usuario validado), `error` (fallo)",
            "enum": ["GoToSignup", "GoToLogin", "error"]
          },
          "status": {
            "type": "integer",
            "description": "Código semántico: 200 (continuar registro / no encontrado), 201 (usuario encontrado y validado), 400 (error de validación)",
            "enum": [200, 201, 400],
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "Mensaje descriptivo del resultado",
            "enum": [
              "Registrar siempre",
              "Usuario no encontrado - Continuar con el registro",
              "Usuario no finalizo el registro - Continuar con el registro",
              "Usuario encontrado",
              "Cliente no encontrado",
              "Error al buscar el usuario"
            ],
            "example": "Usuario no encontrado - Continuar con el registro"
          },
          "sessionId": {
            "type": "string",
            "description": "ID de sesión de Face Liveness y challenge de App Attest. Presente solo cuando `res` es `GoToSignup` (`liveness: true`).",
            "example": "abc123-session-id"
          },
          "liveness": {
            "type": "boolean",
            "description": "Indica si el cliente debe ejecutar la prueba de Face Liveness. `true` cuando `res` es `GoToSignup` (viene con `sessionId`); `false` cuando `res` es `GoToLogin`.",
            "example": true
          },
          "details": {
            "type": "object",
            "description": "Detalle del error interno. Presente solo cuando `res` es `error` y ocurre una excepción."
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["idDocument", "sessionId"],
        "properties": {
          "idDocument": {
            "type": "object",
            "required": ["type", "number", "gender", "name", "lastname", "birth", "issue", "expires", "tramit", "nfc", "address", "front", "back", "photo"],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo de DNI: `O` = DNI Tarjeta, `N` = DNI Anterior, `L` = Ultimo DNI",
                "enum": ["O", "N", "L"],
                "example": "L"
              },
              "number": { "type": "string", "description": "Numero de documento", "example": "35273106" },
              "gender": {
                "type": "string",
                "description": "Sexo del titular: `M` masculino, `F` femenino, `X` no binario",
                "enum": ["M", "F", "X"],
                "example": "M"
              },
              "name": { "type": "string", "example": "IGNACIO MARTIN" },
              "lastname": { "type": "string", "example": "ROSA" },
              "birth": { "type": "string", "description": "Fecha de nacimiento en formato ISO yyyy-MM-dd (distinto al resto de fechas, que van dd/MM/yyyy)", "example": "1990-07-18" },
              "issue": { "type": "string", "description": "Fecha de emision del DNI (dd/MM/yyyy)", "example": "07/04/2023" },
              "expires": { "type": "string", "description": "Fecha de vencimiento del DNI (dd/MM/yyyy)", "example": "07/04/2038" },
              "tramit": { "type": "string", "description": "Numero de tramite del DNI", "example": "00703219306" },
              "nfc": { "type": "boolean", "description": "Si el documento se leyo por NFC", "example": true },
              "nfcCode": { "type": "string", "description": "Codigo NFC de 6 digitos (opcional, solo si nfc = true)", "example": "123456" },
              "example": { "type": "string", "description": "Ejemplar del DNI: A/B/C... (opcional)", "example": "C" },
              "address": { "type": "string", "example": "Av. Siempre Viva 123" },
              "front": { "type": "string", "description": "Frente del DNI en base64 (JPEG/PNG)", "example": "<base64>" },
              "back": { "type": "string", "description": "Dorso del DNI en base64", "example": "<base64>" },
              "photo": { "type": "string", "description": "Foto del documento (cara) en base64, se compara contra el liveness", "example": "<base64>" }
            }
          },
          "sessionId": {
            "type": "string",
            "description": "SessionId de Face Liveness y challenge de App Attest (obtenido en /search o /session).",
            "example": "7792d95f-7f7e-42a8-87b2-b48c7f7d4ac6"
          },
          "idDevice": { "type": "string", "description": "Token del dispositivo (firebase id)" },
          "os": { "type": "string", "example": "IOS-iPhone15,4" },
          "version": { "type": "string", "example": "18.7.8" },
          "esPep": { "type": "boolean", "description": "Indica si es Persona Expuesta Politicamente", "example": false },
          "vinculoPep": { "type": "string", "example": "La misma persona" },
          "cargoPep": { "type": "string" },
          "esSujetoObligado": { "type": "boolean", "example": false },
          "tipoSujetoObligado": { "type": "string" }
        }
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "res": {
            "type": "string",
            "description": "Resultado del registro: `ok` (alta/revancha generada) o `error`.",
            "enum": ["ok", "error"],
            "example": "ok"
          },
          "status": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "Mensaje del resultado. `chance` indica que la similitud quedó en banda intermedia y se requiere responder una pregunta de conocimiento.",
            "example": "chance"
          },
          "similarity": {
            "type": "number",
            "description": "Porcentaje de similitud entre la imagen de referencia del liveness y la foto del documento.",
            "example": 82.5
          },
          "confidence": {
            "type": "number",
            "description": "Nivel de confianza de la prueba de vida (Face Liveness). Presente cuando la prueba de vida no supera el umbral.",
            "example": 42.1
          },
          "question": {
            "type": "object",
            "description": "Pregunta de conocimiento a responder. Presente solo cuando el resultado es revancha (`message: chance`).",
            "properties": {
              "id": { "type": "string", "example": "7" },
              "text": { "type": "string", "example": "Tiene cuenta en alguno de estos Bancos" },
              "0": { "type": "string" },
              "1": { "type": "string" },
              "2": { "type": "string" },
              "3": { "type": "string", "example": "Ninguna es correcta" }
            }
          },
          "authToken": {
            "type": "string",
            "description": "JWT del registro. El payload incluye `attestVrf` (boolean) junto a idUsuario, flow, dni, etc. Necesario para `/chance` y los flujos posteriores."
          },
          "iduser": {
            "type": "integer",
            "description": "ID del usuario creado/actualizado.",
            "example": 12345
          },
          "telefonoVrf": {
            "type": "boolean",
            "example": false
          },
          "emailVrf": {
            "type": "boolean",
            "example": false
          },
          "addressVrf": {
            "type": "boolean",
            "example": false
          },
          "attestVrf": {
            "type": "boolean",
            "description": "true si este signup trajo una assertion de App Attest válida. También va firmado dentro del payload del authToken.",
            "example": false
          },
          "requireData": {
            "type": "object",
            "description": "Settings del whitebrand que indican cómo continuar el flujo (mail/phone/addressValidationMandatory)."
          },
          "details": {
            "type": "object",
            "description": "Detalle del error. Presente solo cuando `res` es `error`."
          }
        }
      },
      "AppAttestChallengeResponse": {
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Nonce para attestKey / POST /attest/enroll. No es un sessionId de liveness.",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        }
      },
      "AppAttestEnrollRequest": {
        "type": "object",
        "required": ["keyId", "attestation", "challenge"],
        "properties": {
          "keyId": {
            "type": "string",
            "description": "Identificador de la key de App Attest (base64)"
          },
          "attestation": {
            "type": "string",
            "description": "Attestation object de Apple en base64"
          },
          "challenge": {
            "type": "string",
            "description": "Nonce de GET /attest/challenge (recomendado). También acepta un sessionId de liveness si ya estaba persistido."
          }
        }
      },
      "AppAttestEnrollResponse": {
        "type": "object",
        "properties": {
          "res": { "type": "string", "enum": ["ok", "error"] },
          "status": { "type": "integer", "example": 200 },
          "message": { "type": "string" },
          "keyId": { "type": "string" },
          "details": { "type": "string" }
        }
      },
      "UnauthorizedResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Please make sure your request has a valid Authorization header"
          }
        }
      },
      "LegalDocumentResponse": {
        "type": "object",
        "properties": {
          "res": {
            "type": "string",
            "enum": ["ok", "error"]
          },
          "status": {
            "type": "integer",
            "example": 200
          },
          "brand": {
            "type": "string",
            "description": "ID de la marca blanca (ej. kiwipayauth)",
            "example": "kiwipayauth"
          },
          "brandName": {
            "type": "string",
            "description": "Nombre para mostrar de la marca",
            "example": "Kiwipay Auth"
          },
          "type": {
            "type": "string",
            "enum": ["tyc", "privacy"]
          },
          "html": {
            "type": "string",
            "description": "Contenido HTML del documento legal"
          },
          "message": {
            "type": "string",
            "description": "Mensaje de error cuando res es error"
          }
        }
      },
      "Localidad": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "25 DE MAYO" },
          "code": {
            "type": "string",
            "description": "Código UTA 2020",
            "example": "068540854100000"
          }
        }
      },
      "Municipio": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "localidades": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Localidad" }
          }
        }
      },
      "Departamento": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "municipios": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Municipio" }
          }
        }
      },
      "Provincia": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "BUENOS AIRES" },
          "departamentos": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Departamento" }
          },
          "departamentos_selectable": {
            "type": "boolean",
            "description": "Si el nivel departamento/partido es seleccionable en UI",
            "example": true
          },
          "departamento_label": {
            "type": "string",
            "description": "Etiqueta UI para el nivel departamento",
            "example": "Partido"
          },
          "municipios_selectable": {
            "type": "boolean",
            "description": "Si el nivel municipio es seleccionable en UI",
            "example": true
          },
          "municipio_label": {
            "type": "string",
            "description": "Etiqueta UI para el nivel municipio",
            "example": "Municipio"
          },
          "localidad_label": {
            "type": "string",
            "description": "Etiqueta UI para el nivel localidad",
            "example": "Localidad"
          }
        }
      },
      "LocalitiesResponse": {
        "type": "object",
        "properties": {
          "provincias": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Provincia" }
          }
        }
      },
      "UpdateAddressRequest": {
        "type": "object",
        "required": ["token", "pais", "provincia", "localidad", "codigoPostal", "calle", "numero"],
        "properties": {
          "token": {
            "type": "string",
            "description": "authToken emitido en signup/auth (mismo que email/teléfono)"
          },
          "pais": { "type": "string", "description": "ISO 2", "example": "AR" },
          "provincia": { "type": "string", "example": "BUENOS AIRES" },
          "localidad": { "type": "string", "example": "25 DE MAYO" },
          "codigoPostal": { "type": "string", "example": "6660" },
          "calle": { "type": "string", "example": "Av. Siempre Viva" },
          "numero": { "type": "string", "example": "123" },
          "piso": { "type": "string", "example": "2" },
          "depto": { "type": "string", "example": "B" },
          "codigoUta": {
            "type": "string",
            "description": "Código UTA de la localidad (opcional, campo `code` del catálogo AR_min.json)",
            "example": "068540854100000"
          }
        }
      },
      "UpdateAddressResponse": {
        "type": "object",
        "properties": {
          "res": { "type": "string", "enum": ["ok", "error"] },
          "status": { "type": "integer", "example": 200 },
          "message": {
            "type": "string",
            "description": "Estado resultante (`Ok` / `Verificar`) o mensaje de error"
          },
          "addressVrf": { "type": "boolean", "example": true }
        }
      }
    }
  }
}
